# Normalise every text file to LF in the repository so Windows and Linux
# contributors produce identical diffs.
* text=auto eol=lf

*.rs       text eol=lf
*.toml     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.lock     text eol=lf

# Binary artefacts
*.png      binary
*.ico      binary
*.exe      binary
*.node     binary

# Generated / vendored
Cargo.lock linguist-generated=true
